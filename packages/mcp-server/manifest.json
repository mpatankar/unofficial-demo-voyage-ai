{
  "dxt_version": "0.2",
  "name": "voyage-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Voyage API",
  "author": {
    "name": "Voyage",
    "email": "contact@voyageai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpatankar/unofficial-demo-voyage-ai.git"
  },
  "homepage": "https://github.com/mpatankar/unofficial-demo-voyage-ai/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.voyageai.com/docs/faq",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "VOYAGE_API_KEY": "${user_config.VOYAGE_API_KEY}"
      }
    }
  },
  "user_config": {
    "VOYAGE_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
